{
  "name": "verse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --max-warnings 0",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run audit:prod && npm run test && npm run build"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@stomp/stompjs": "^7.3.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "pinia": "^2.3.0",
    "qrcode": "^1.5.4",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.13",
    "vue-echarts": "^8.3.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "sass": "^1.83.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
